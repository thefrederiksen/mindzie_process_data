# Mindzie Studio Configuration
# Copy this file to .env and fill in your actual values

# Required: Your Mindzie tenant ID (found in Studio 'About' box)
TENANT_ID=your-tenant-id-here

# Required: Your Mindzie project ID (found in Studio 'About' box)
PROJECT_ID=your-project-id-here

# Required: Your Mindzie API key (Administration Settings > API keys)
API_KEY=your-api-key-here

# Optional Configuration
# API base URL (default: https://www.mindziestudio.com)
API_BASE_URL=https://www.mindziestudio.com

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Output format for generated files (json, csv, or both)
OUTPUT_FORMAT=both

# API retry settings
MAX_RETRIES=3
CHUNK_SIZE=1000

# Domain-Specific Settings for Hire to Retire

# Generate events only during business hours
BUSINESS_HOURS_ONLY=true

# Timezone for timestamps (default: UTC)
TIMEZONE=UTC

# Organization names
CUSTOMER_ORG_NAME=Customer
OUTSOURCE_ORG_NAME=XYZ

# Default HR system names
CUSTOMER_SYSTEM=Customer_System
OUTSOURCE_SYSTEM=XYZ_HRIS